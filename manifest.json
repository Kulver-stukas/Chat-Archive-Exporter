{
  "manifest_version": 3,
  "name": "Chat Archive Exporter BETA",
  "description": "ChatGPT Markdown and original-source export to Vault, with opt-in workspace-scoped background updates.",
  "version": "0.1.9.9",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "tabs",
    "storage",
    "alarms",
    "offscreen",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "action": {
    "default_title": "Chat Archive Exporter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/cae-base-16.png",
      "32": "icons/cae-base-32.png"
    }
  },
  "background": {
    "service_worker": "worker.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "lib/export-selection.js",
        "lib/normalize.js",
        "lib/config-inventory.js",
        "lib/source-transfer.js",
        "lib/library-inventory.js",
        "lib/api.js",
        "content.js",
        "sync-watch.js",
        "ui/widget.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "version_name": "0.1.9 rev.9 (beta)",
  "icons": {
    "16": "icons/cae-base-16.png",
    "32": "icons/cae-base-32.png",
    "48": "icons/cae-base-48.png",
    "128": "icons/cae-base-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
